<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dojoy.reverse-ssh-hermes</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-R</string>
    <string>127.0.0.1:22224:127.0.0.1:22</string>
    <string>-o</string>
    <string>ServerAliveInterval=30</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <string>-o</string>
    <string>ExitOnForwardFailure=yes</string>
    <string>-o</string>
    <string>IdentitiesOnly=yes</string>
    <string>-i</string>
    <string>/Users/dojoy/.ssh/id_ed25519_hermes_reverse</string>
    <string>hermes-vps</string>
  </array>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/dojoy/Library/Logs/reverse-ssh-hermes.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dojoy/Library/Logs/reverse-ssh-hermes.log</string>
</dict>
</plist>
