# DOJOY 服务器终端：接入 @@NAME@@（@@ID@@）。由 remote-term-admin join 生成，只能用一次。
# Windows PowerShell 5.1，用管理员身份运行。重复运行是安全的。
# 变量后面紧跟中文时一律写成 ${变量}：PowerShell 会把中文字符当成变量名的一部分。
$ErrorActionPreference = 'Stop'
# Started from PowerShell 7, Windows PowerShell 5.1 inherits a module path pointing at 7's own
# modules, which it cannot load (Set-Acl and others then "could not be loaded"). Use the
# system's module path instead.
$env:PSModulePath = [Environment]::GetEnvironmentVariable('PSModulePath', 'Machine')
$HostId = @@Q_ID@@
$HostName = @@Q_NAME@@
$SshUser = @@Q_USER@@
$Gateway = @@Q_DOMAIN@@
$ReportUrl = @@Q_REPORT_URL@@
$EnrollUrl = @@Q_ENROLL_URL@@
$Token = @@Q_TOKEN@@
$TerminalKey = @@Q_TERMINAL_KEY@@
$GatewayHostKey = @@Q_GATEWAY_HOSTKEY@@
$TunnelPort = @@Q_TUNNEL_PORT@@
$AgentScript = @@Q_AGENT@@
$TunnelScript = @@Q_TUNNEL@@

$Base = Join-Path $env:ProgramData 'remote-term'
$SshDir = Join-Path $env:ProgramData 'ssh'
$OpenSsh = Join-Path $env:SystemRoot 'System32\OpenSSH'
$PowerShellExe = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
$AdminsSid = 'S-1-5-32-544'
$SystemSid = 'S-1-5-18'
$TunnelTask = 'DOJOY remote-term tunnel'
$AgentTask = 'DOJOY remote-term agent'

function Test-Elevated {
    $principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
    return $principal.IsInRole([Security.Principal.SecurityIdentifier]$AdminsSid)
}

function Write-Ascii([string]$path, [string]$text) {
    # sshd cannot read the UTF-16 files PowerShell 5.1 writes by default.
    [IO.File]::WriteAllText($path, $text, (New-Object Text.ASCIIEncoding))
}

function Protect-Path([string]$path) {
    # Only SYSTEM and Administrators (by SID: group names are translated on some systems).
    # sshd requires this of administrators_authorized_keys and of private keys.
    & icacls.exe $path /inheritance:r /grant "*${SystemSid}:(OI)(CI)F" "*${AdminsSid}:(OI)(CI)F" | Out-Null
    if ($LASTEXITCODE -ne 0) { throw "icacls 设置权限失败：$path" }
}

function Protect-File([string]$path) {
    # Replace the whole ACL: owner Administrators, access for SYSTEM and Administrators only.
    # ssh-keygen gives the account that ran it its own entry; Windows OpenSSH then refuses the
    # private key ("Bad permissions") when the SYSTEM-run tunnel uses it.
    $acl = New-Object Security.AccessControl.FileSecurity
    $acl.SetAccessRuleProtection($true, $false)
    $acl.SetOwner((New-Object Security.Principal.SecurityIdentifier($AdminsSid)))
    foreach ($sid in @($SystemSid, $AdminsSid)) {
        $identity = New-Object Security.Principal.SecurityIdentifier($sid)
        $acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($identity, 'FullControl', 'Allow')))
    }
    [IO.File]::SetAccessControl($path, $acl)
}

function Protect-SshdConfig([string]$config) {
    # This PC's sshd is only reached through the tunnel: listen on 127.0.0.1 only, keys only.
    # sshd takes the first value it reads, so these go on top.
    $lines = @(Get-Content -LiteralPath $config | Where-Object { $_ -notmatch '^# DOJOY remote-term' })
    $header = @('# DOJOY remote-term: reached only through the tunnel; keys only.',
                'ListenAddress 127.0.0.1', 'PasswordAuthentication no', '')
    if ($lines.Count -ge 3 -and $lines[0] -eq $header[1] -and $lines[1] -eq $header[2]) { return }
    Write-Ascii $config ((($header + $lines) -join "`r`n") + "`r`n")
}

function Install-OpenSshServer {
    $fresh = $false
    if (-not (Get-Service -Name sshd -ErrorAction SilentlyContinue)) {
        Write-Host '正在开启 Windows 自带的 OpenSSH 服务（第一次可能要几分钟，请耐心等待）……'
        $capability = Get-WindowsCapability -Online | Where-Object { $_.Name -like 'OpenSSH.Server*' } |
            Select-Object -First 1
        if (-not $capability) { throw '这台电脑找不到「OpenSSH 服务器」这个可选功能。' }
        Add-WindowsCapability -Online -Name $capability.Name | Out-Null
        $fresh = $true
    }
    Set-Service -Name sshd -StartupType Automatic
    Start-Service -Name sshd
    if ($fresh) {
        # First start generated the host keys and sshd_config; now lock it down.
        Protect-SshdConfig (Join-Path $SshDir 'sshd_config')
        Restart-Service -Name sshd
        Write-Host '已开启 OpenSSH 服务：只监听本机，只允许密钥登录。'
    } else {
        Write-Host 'OpenSSH 服务原来就装着，它的配置保持不变。'
    }
    $shellKey = 'HKLM:\SOFTWARE\OpenSSH'
    if (-not (Test-Path -LiteralPath $shellKey)) { New-Item -Path $shellKey -Force | Out-Null }
    if (-not (Get-ItemProperty -LiteralPath $shellKey -Name DefaultShell -ErrorAction SilentlyContinue)) {
        New-ItemProperty -LiteralPath $shellKey -Name DefaultShell -Value $PowerShellExe -PropertyType String `
            -Force | Out-Null
    }
}

function Install-TerminalKey([string]$line, [string]$tag) {
    # The account is an administrator (it is running this elevated), so sshd reads this file.
    $file = Join-Path $SshDir 'administrators_authorized_keys'
    $kept = @()
    if (Test-Path -LiteralPath $file) {
        $kept = @(Get-Content -LiteralPath $file | Where-Object { $_.Trim() -and ($_.Trim() -split '\s+')[-1] -ne $tag })
    }
    Write-Ascii $file ((($kept + @($line)) -join "`r`n") + "`r`n")
    Protect-File $file
    return $file
}

function Install-Tunnel {
    $key = Join-Path $Base 'tunnel_key'
    if (-not (Test-Path -LiteralPath $key)) {
        # '""' is how Windows PowerShell 5.1 passes an empty passphrase to a native program.
        & (Join-Path $OpenSsh 'ssh-keygen.exe') -q -t ed25519 -N '""' -C "remote-term-tunnel-$HostId" -f $key
        if ($LASTEXITCODE -ne 0) { throw '生成隧道密钥失败。' }
    }
    Protect-File $key
    $knownHosts = Join-Path $Base 'known_hosts'
    $gatewayKey = ($GatewayHostKey -split '\s+')[0..1] -join ' '
    Write-Ascii $knownHosts ("remote-term-gateway $gatewayKey`r`n")
    $script = Join-Path $Base 'tunnel.ps1'
    Write-Ascii $script $TunnelScript
    $arguments = ('-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "{0}" ' +
                  '-Gateway {1} -Port {2} -KeyFile "{3}" -KnownHosts "{4}"') -f $script, $Gateway, $TunnelPort, $key, $knownHosts
    Register-BootTask $TunnelTask $arguments
    return $key
}

function Register-BootTask([string]$name, [string]$arguments) {
    # Runs as SYSTEM from boot, without anyone logged in; restarts if it ever stops.
    Stop-ScheduledTask -TaskName $name -ErrorAction SilentlyContinue
    $action = New-ScheduledTaskAction -Execute $PowerShellExe -Argument $arguments
    $trigger = New-ScheduledTaskTrigger -AtStartup
    $principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
    $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries `
        -StartWhenAvailable -ExecutionTimeLimit ([TimeSpan]::Zero) -RestartCount 999 `
        -RestartInterval (New-TimeSpan -Minutes 1) -MultipleInstances IgnoreNew
    Register-ScheduledTask -TaskName $name -Action $action -Trigger $trigger -Principal $principal `
        -Settings $settings -Force | Out-Null
    Start-ScheduledTask -TaskName $name
}

function Install-Agent {
    $script = Join-Path $Base 'agent.ps1'
    Write-Ascii $script $AgentScript
    $tokenFile = Join-Path $Base 'token'
    Write-Ascii $tokenFile ($Token + "`r`n")
    Protect-File $tokenFile
    & $script -Url $ReportUrl -TokenFile $tokenFile -Once | Out-Null
    if ($LASTEXITCODE -ne 0) { throw '首次上报失败，见上面的提示。' }
    $arguments = '-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "{0}" -Url {1} -TokenFile "{2}"' `
        -f $script, $ReportUrl, $tokenFile
    Register-BootTask $AgentTask $arguments
    return $tokenFile
}

function Send-Enrollment([string]$tokenFile, [string]$tunnelKey) {
    $hostKeys = @(Get-ChildItem -Path (Join-Path $SshDir 'ssh_host_*_key.pub') | ForEach-Object { $_.FullName })
    if ($hostKeys.Count -eq 0) { throw '找不到这台电脑的 SSH 主机公钥。' }
    & (Join-Path $Base 'agent.ps1') -Url $EnrollUrl -TokenFile $tokenFile -Enroll -HostKeyFiles $hostKeys `
        -TunnelKeyFile ($tunnelKey + '.pub') | Out-Null
    if ($LASTEXITCODE -ne 0) { throw '登记失败，见上面的提示。' }
}

function Invoke-Join {
    Write-Host "== 正在接入 ${HostName}（${HostId}）=="
    if (-not (Test-Elevated)) {
        throw '需要管理员权限：请在开始菜单上点右键，选「终端(管理员)」，再粘贴一次。'
    }
    if ($env:USERNAME -ne $SshUser) {
        throw "请在 ${SshUser} 账户下运行（当前是 ${env:USERNAME}）。"
    }
    New-Item -ItemType Directory -Force -Path $Base | Out-Null
    Protect-Path $Base
    Install-OpenSshServer
    Install-TerminalKey ("restrict,pty $TerminalKey remote-term-$HostId") "remote-term-$HostId" | Out-Null
    Write-Host '已安装网页终端公钥（restrict,pty）。'
    $tunnelKey = Install-Tunnel
    Write-Host '隧道已启动：开机自动运行，断线后自动重连。'
    $tokenFile = Install-Agent
    Write-Host '上报成功：开机自动运行，每 30 秒上报一次。'
    Send-Enrollment $tokenFile $tunnelKey
    Write-Host ''
    Write-Host "完成：${HostName} 已接入。大约 1 分钟后，在网页上就能看到它的状态并打开终端。"
}

# Tests load the functions above without running anything.
if (-not $env:DOJOY_JOIN_LIBRARY_ONLY) {
    try {
        Invoke-Join
    } catch {
        Write-Host ('接入失败：' + $_.Exception.Message) -ForegroundColor Red
        exit 1
    } finally {
        # The script holds this PC's report token: remove the downloaded copy.
        if ($PSCommandPath -and (Split-Path -Leaf $PSCommandPath) -like 'dojoy-join*.ps1') {
            Remove-Item -LiteralPath $PSCommandPath -Force -ErrorAction SilentlyContinue
        }
    }
}
