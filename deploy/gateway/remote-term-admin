def build_join_script(host, domain, token, terminal_key, bundle, password_hash="", gateway_hostkey=""):
    values = {
        "ID": host["id"], "NAME": host["name"], "KIND": host["kind"], "USER": host["ssh_user"],
        "DOMAIN": domain, "REPORT_URL": f"https://{domain}/api/report",
        "ENROLL_URL": f"https://{domain}/api/enroll", "TOKEN": token, "TERMINAL_KEY": terminal_key,
        "PASSWORD_HASH": password_hash, "GATEWAY_HOSTKEY": gateway_hostkey,
        "TUNNEL_PORT": str(host["ssh_port"]) if host["tunnel"] else "", "BUNDLE": bundle,
    }
    text = JOIN_TEMPLATE
    for key, value in values.items():
        text = text.replace(f"@@Q_{key}@@", shlex.quote(value))
    # Names only appear in the comment line; strip anything that could end it.
    text = text.replace("@@NAME@@", re.sub(r"[\r\n]", " ", host["name"])).replace("@@ID@@", host["id"])
    if "@@" in text:
        raise ValueError("unrendered placeholder in join script")
    return text


def join_command(domain, secret):
    url = f"https://{domain}/join/{secret}.sh"
    return f"curl -fsSLo /tmp/dojoy-join.sh '{url}' && bash /tmp/dojoy-join.sh"


# ---------- system helpers ----------

def run(argv, check=True, **kwargs):
    return subprocess.run(argv, check=check, text=True, **kwargs)


def write_file(path, content, mode=0o644, owner=None):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=path.parent, prefix="." + path.name + ".")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(content)
        os.chmod(temporary, mode)
        if owner:
            shutil.chown(temporary, *owner)
        os.replace(temporary, path)
    except BaseException:
        Path(temporary).unlink(missing_ok=True)
        raise


def read_text(path):
    try:
        return Path(path).read_text(encoding="utf-8")
    except FileNotFoundError:
        return ""


def read_json(path, default):
    try:
        return json.loads(read_text(path) or "null") or default
    except ValueError:
        return default


def hosts_by_id():
    try:
        hosts = load_hosts(HOME / "hosts.json")
    except HostsConfigError as error:
        raise AdminError(f"hosts.json 无效：{error}") from None
    # Addresses learned at run time (old ssh config, enrollment source IP) fill placeholders.
    apply_address_overrides(hosts, read_json(ETC / "addresses.json", {}))
    return {host["id"]: host for host in hosts}


def get_host(host_id):
    host = hosts_by_id().get(host_id)
    if host is None:
        raise AdminError(f"hosts.json 里没有 {host_id}。")
    return host


def fingerprint(key_type, blob):
    result = run(["ssh-keygen", "-lf", "-"], input=f"{key_type} {blob}\n", capture_output=True)
    return result.stdout.strip()


def key_path(host_id):
    return ETC / "keys" / host_id


def pinned(host_id):
    return any(line.split()[:1] == [host_id] for line in read_text(ETC / "known_hosts").splitlines())


def systemctl(*args, check=True):
    return run(["systemctl", *args], check=check, capture_output=True)


# ---------- commands ----------

def generate_key(host_id):
    path = key_path(host_id)
    for stale in (path, path.with_name(path.name + ".pub")):
        stale.unlink(missing_ok=True)
    run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"remote-term-{host_id}", "-f", str(path)])
    shutil.chown(path, TTYD_USER, TTYD_USER)
    os.chmod(path, 0o600)


def cmd_keygen(args):
    get_host(args.host_id)
    path = key_path(args.host_id)
    if path.exists() and not args.force:
        print(f"{path} 已存在；如要轮换密钥请加 --force。当前公钥行：", file=sys.stderr)
    else:
        generate_key(args.host_id)
    cmd_pubkey(args)


def cmd_pubkey(args):
    pub = key_path(args.host_id).with_name(args.host_id + ".pub")
    if not pub.exists():
        raise AdminError(f"还没有 {args.host_id} 的密钥，先运行 keygen。")
    key_type, blob = parse_public_key(pub.read_text())
    print(terminal_key_line(args.host_id, key_type, blob))


def cmd_token(args):
    get_host(args.host_id)
    from receiver import TokenStore
    token = TokenStore(ETC / "agent-tokens.json").issue(args.host_id)
    print(token)
    print(f"这是 {args.host_id} 的上报 token，只显示这一次；旧 token 已失效。", file=sys.stderr)


def cmd_revoke_token(args):
    from receiver import TokenStore
    if not TokenStore(ETC / "agent-tokens.json").revoke(args.host_id):
        raise AdminError(f"{args.host_id} 没有 token。")
    print(f"{args.host_id} 的上报 token 已作废。")


def cmd_hostkey(args):
    get_host(args.host_id)
    key_type, blob = parse_public_key(" ".join(args.key))
    path = ETC / "known_hosts"
    write_file(path, replace_tagged_line(read_text(path), args.host_id,
                                         known_hosts_line(args.host_id, key_type, blob)))
    print(f"已固定 {args.host_id} 的主机公钥：{fingerprint(key_type, blob)}")
    print("请与目标机上 `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub` 的输出逐字比对。")


def cmd_tunnel_key(args):
    host = get_host(args.host_id)
    if not host["tunnel"]:
        raise AdminError(f"{args.host_id} 在 hosts.json 里不是隧道机器（tunnel: true）。")
    key_type, blob = parse_public_key(" ".join(args.key))
    path = ETC / "tunnel_authorized_keys"
    write_file(path, replace_tagged_line(read_text(path), f"remote-term-tunnel-{args.host_id}",
                                         tunnel_key_line(host, key_type, blob)))
    print(f"已授权 {args.host_id} 的隧道公钥，只能监听 127.0.0.1:{host['ssh_port']}：{fingerprint(key_type, blob)}")


def ssh_check(host_id):
    probe = "id -un; sudo -n true 2>/dev/null && echo SUDO_NOPASSWD || echo SUDO_NEEDS_PASSWORD"
    result = run(["runuser", "-u", TTYD_USER, "--", "/usr/bin/ssh", "-F", str(ETC / "ssh_config"),
                  host_id, probe], check=False, capture_output=True, timeout=30)
    return result.returncode, result.stdout.split()


def cmd_check(args):
    host = get_host(args.host_id)
    problems = []
    if host["ssh_host"].startswith("REPLACE"):
        problems.append("hosts.json 里还是占位地址")
    if not key_path(args.host_id).exists():
        problems.append("还没有生成密钥（keygen）")
    if not pinned(args.host_id):
        problems.append("还没有固定主机公钥（hostkey）")
    if problems:
        raise AdminError(f"{args.host_id}：" + "；".join(problems) + "。")
    code, words = ssh_check(args.host_id)
    if code != 0 or not words:
        raise AdminError(f"{args.host_id}：SSH 登录测试失败（退出码 {code}）。检查目标机的 authorized_keys、"
                         "防火墙，以及隧道是否已连上。")
    user, sudo = words[0], words[-1]
    if sudo == "SUDO_NOPASSWD":
        raise AdminError(f"{args.host_id}：用户 {user} 执行 sudo 不需要密码。请先改为需要密码，"
                         "否则入口机一旦失陷就等于拿到 root。")
    print(f"{args.host_id}：SSH 正常，登录用户 {user}，sudo 需要密码。")


def cmd_enable(args):
    if not args.skip_check:
        cmd_check(args)
    systemctl("enable", "--now", f"remote-ttyd@{args.host_id}.service")
    print(f"已启用 {args.host_id} 的网页终端。")


def cmd_disable(args):
    systemctl("disable", "--now", f"remote-ttyd@{args.host_id}.service", check=False)
    print(f"已停用 {args.host_id} 的网页终端。")


def cmd_list(args):
    try:
        with urllib.request.urlopen(RECEIVER_STATUS_URL, timeout=3) as response:
            reports = {row["id"]: row for row in json.load(response)["hosts"]}
    except (OSError, ValueError, KeyError):
        reports = {}
    try:
        token_ids = set(json.loads(read_text(ETC / "agent-tokens.json") or "{}").get("tokens", {}))
    except (ValueError, AttributeError):
        token_ids = set()
    print(f"{'机器':<14}{'密钥':<6}{'主机公钥':<10}{'token':<7}{'终端':<10}上报状态")
    for host_id, host in hosts_by_id().items():
        active = systemctl("is-active", f"remote-ttyd@{host_id}.service", check=False).stdout.strip() or "?"
        report = reports.get(host_id, {}).get("status", "?")
        address = "（占位地址）" if host["ssh_host"].startswith("REPLACE") else ""
        has_key = "有" if key_path(host_id).exists() else "无"
        has_pin = "已固定" if pinned(host_id) else "未固定"
        has_token = "有" if host_id in token_ids else "无"
        print(f"{host_id:<14}{has_key:<6}{has_pin:<10}{has_token:<7}{active:<10}{report}{address}")


# ---------- one-paste joining ----------

def domain_name():
    domain = read_text(ETC / "domain").strip()
    if not domain:
        raise AdminError(f"缺少 {ETC / 'domain'}；请先运行 install_gateway.sh。")
    return domain


def ensure_key(host_id):
    if not key_path(host_id).exists():
        generate_key(host_id)
    key_type, blob = parse_public_key(key_path(host_id).with_name(host_id + ".pub").read_text())
    return terminal_key_line(host_id, key_type, blob)


def joins():
    return read_json(ETC / "joins.json", {})


def save_joins(data):
    write_file(ETC / "joins.json", json.dumps(data, ensure_ascii=False, indent=2) + "\n", mode=0o600)


def remove_join(host_id):
    data = joins()
    entry = data.pop(host_id, None)
    if entry:
        (JOIN_DIR / f"{entry['secret']}.sh").unlink(missing_ok=True)
        save_joins(data)


def enrolled(host_id):
    return pinned(host_id) and systemctl("is-enabled", f"remote-ttyd@{host_id}.service",
                                         check=False).stdout.strip() == "enabled"


def make_join(host, domain, force=False):
    """Create (or reuse) this host's one-time join script; return the command to paste."""
    data = joins()
    entry = data.get(host["id"])
    if entry and not force and (JOIN_DIR / f"{entry['secret']}.sh").exists():
        return join_command(domain, entry["secret"])
    password_hash = read_text(ETC / "ops-password.hash").strip()
    if host["kind"] == "linux" and not password_hash:
        raise AdminError("缺少 ops 密码哈希；请重新运行 install_gateway.sh。")
    gateway_hostkey = " ".join(read_text(GATEWAY_HOSTKEY).split()[:2])
    from receiver import TokenStore
    token = TokenStore(ETC / "agent-tokens.json").issue(host["id"])
    script = build_join_script(host, domain, token, ensure_key(host["id"]), build_bundle(HOME),
                               password_hash if host["kind"] == "linux" else "", gateway_hostkey)
    if entry:
        (JOIN_DIR / f"{entry['secret']}.sh").unlink(missing_ok=True)
    secret = secrets.token_hex(16)
    JOIN_DIR.mkdir(mode=0o750, exist_ok=True)
    shutil.chown(JOIN_DIR, "root", NGINX_GROUP)
    write_file(JOIN_DIR / f"{secret}.sh", script, mode=0o640, owner=("root", NGINX_GROUP))
    data[host["id"]] = {"secret": secret, "created_at": datetime.now(timezone.utc).isoformat(timespec="seconds")}
    save_joins(data)
    return join_command(domain, secret)


def where_to_paste(host):
    if host["kind"] == "mac":
        return f"在这台 Mac 上用 {host['ssh_user']} 账户打开「终端」App，粘贴下面一整行，回车："
    return "在这台服务器的网页终端里（云平台控制台的「远程连接 / 登录」），粘贴下面一整行，回车："


def cmd_join(args):
    host = get_host(args.host_id)
    if host["id"] == "vps":
        raise AdminError("vps 是入口机本身，install_gateway.sh 已经接好了。")
    print(make_join(host, domain_name(), args.force))


def write_join_page(domain):
    """The site's join.txt: the commands still waiting to be pasted (behind the login)."""
    hosts = hosts_by_id()
    sections = [f"【{hosts[host_id]['name']}（{host_id}）】{where_to_paste(hosts[host_id])}\n"
                f"{join_command(domain, entry['secret'])}\n"
                for host_id, entry in joins().items() if host_id in hosts]
    page = WWW / "join.txt"
    if not sections:
        page.unlink(missing_ok=True)
        return "所有机器都已接入。"
    text = ("DOJOY 服务器终端：接入其他机器\n\n"
            "每台机器只需要做一次。每条命令只能用一次，接入成功后自动作废。\n"
            "粘贴完大约 1 分钟后，回到网页刷新，就能看到这台机器并打开终端。\n\n"
            + "\n".join(sections))
    write_file(page, text)
    return text


def cmd_join_all(args):
    domain = domain_name()
    for host in hosts_by_id().values():
        if host["id"] != "vps" and not enrolled(host["id"]):
            make_join(host, domain)
    print(write_join_page(domain))


def cmd_legacy_ips(args):
    """Fill placeholder addresses from root's old ~/.ssh/config (the old VPS had these aliases)."""
    overrides = read_json(ETC / "addresses.json", {})
    for host in hosts_by_id().values():
        if not host["ssh_host"].startswith("REPLACE"):
            continue
        result = run(["ssh", "-G", host["id"]], check=False, capture_output=True)
        address = parse_ssh_g_hostname(result.stdout, host["id"]) if result.returncode == 0 else None
        if address:
            overrides[host["id"]] = address
            print(f"{host['id']}：从旧的 SSH 配置读到地址 {address}")
    write_file(ETC / "addresses.json", json.dumps(overrides, indent=2) + "\n")


def try_enable(host_id):
    try:
        cmd_check(argparse.Namespace(host_id=host_id))
    except AdminError as error:
        print(f"{host_id}：暂时还不能启用终端（{error}），下次自动重试。", file=sys.stderr)
        return False
    systemctl("enable", "--now", f"remote-ttyd@{host_id}.service")
    print(f"{host_id}：已启用网页终端。")
    return True


def cmd_sync(args):
    """Apply enrollments: pin host keys, authorize Mac tunnel keys, fill addresses, start terminals."""
    hosts = hosts_by_id()
    outstanding = joins()
    pending = set(read_text(ETC / "pending-enable").split())
    overrides = read_json(ETC / "addresses.json", {})
    rerender = False
    for path in sorted(ENROLL_DIR.glob("*.json")) if ENROLL_DIR.exists() else []:
        host = hosts.get(path.stem)
        try:
            document = json.loads(path.read_text(encoding="utf-8"))
            if host is None or document.get("host_id") != host["id"]:
                raise AdminError("登记里的机器不在 hosts.json 中")
            # Only a host with an unused join link may (re)enroll; a token alone is not enough
            # to swap the pinned host keys. To re-join on purpose: remote-term-admin join <id> --force
            if host["id"] not in outstanding:
                raise AdminError(f"{host['id']} 没有待使用的接入链接，如需重新接入请先运行 join {host['id']} --force")
            keys = [parse_public_key(key) for key in document.get("host_keys") or []]
            if not keys:
                raise AdminError("登记里没有主机公钥")
            tunnel = parse_public_key(document.get("tunnel_key") or "") if host["tunnel"] else None
        except (AdminError, ValueError, KeyError, TypeError) as error:
            rejected = ENROLL_DIR.parent / "enroll-rejected"
            rejected.mkdir(mode=0o700, exist_ok=True)
            os.replace(path, rejected / path.name)
            print(f"{path.stem}：登记无效，已移到 {rejected}（{error}）", file=sys.stderr)
            continue
        known = ETC / "known_hosts"
        write_file(known, replace_host_lines(read_text(known), host["id"],
                                             [known_hosts_line(host["id"], *key) for key in keys]))
        if tunnel:
            authorized = ETC / "tunnel_authorized_keys"
            write_file(authorized, replace_tagged_line(read_text(authorized), f"remote-term-tunnel-{host['id']}",
                                                       tunnel_key_line(host, *tunnel)))
        source_ip = document.get("source_ip")
        if host["ssh_host"].startswith("REPLACE") and source_ip:
            overrides[host["id"]] = source_ip
            rerender = True
        remove_join(host["id"])
        path.unlink()
        pending.add(host["id"])
        print(f"{host['id']}：已固定主机公钥" + ("、授权隧道" if tunnel else "") + "。")
    if rerender:
        write_file(ETC / "addresses.json", json.dumps(overrides, indent=2) + "\n")
        cmd_apply(argparse.Namespace())
    for host_id in sorted(pending):
        if host_id in hosts and try_enable(host_id):
            pending.discard(host_id)
    write_file(ETC / "pending-enable", "".join(f"{host_id}\n" for host_id in sorted(pending)))
    if (WWW / "join.txt").exists():
        write_join_page(domain_name())


def cmd_apply(args):
    import render_config
    domain = read_text(ETC / "domain").strip()
    if not domain:
        raise AdminError(f"缺少 {ETC / 'domain'}；请先运行 install_gateway.sh。")
    hosts = list(hosts_by_id().values())
    files = render_config.render_all(hosts, domain)
    write_file(NGINX_AVAILABLE, files.pop("nginx/remote-term.conf"))
    if not NGINX_ENABLED.is_symlink():
        NGINX_ENABLED.unlink(missing_ok=True)
        NGINX_ENABLED.symlink_to(NGINX_AVAILABLE)
    if NGINX_DEFAULT.is_symlink():
        NGINX_DEFAULT.unlink()
    write_file(ETC / "ssh_config", files.pop("ssh_config"))
    write_file(ETC / "aliases", files.pop("aliases"))
    write_file(WWW / "hosts.js", files.pop("web/hosts.js"))
    for name in WEB_FILES:
        write_file(WWW / name, (HOME / "web" / name).read_text(encoding="utf-8"))
    assert not files, f"unhandled rendered files: {sorted(files)}"
    units = systemctl("list-units", "--plain", "--no-legend", "--state=active", "remote-ttyd@*.service",
                      check=False).stdout
    for unit in re.findall(r"remote-ttyd@([a-z0-9-]+)\.service", units):
        if unit not in {host["id"] for host in hosts}:
            print(f"hosts.json 已删除 {unit}：请运行 remote-term-admin disable {unit}", file=sys.stderr)
    pending = placeholders(hosts)
    if pending:
        print("这些机器在 hosts.json 里还是占位地址，终端暂不可用：" + "、".join(pending), file=sys.stderr)
    certificate = Path(f"/etc/letsencrypt/live/{domain}/fullchain.pem")
    if certificate.exists():
        run(["nginx", "-t"], capture_output=True)
        systemctl("reload-or-restart", "nginx")
    else:
        print(f"还没有 {domain} 的证书，nginx 未重新加载。", file=sys.stderr)
    systemctl("try-restart", "remote-term-receiver.service", check=False)
    print("配置已生成并安装。")


def main(argv=None):
    parser = argparse.ArgumentParser(prog="remote-term-admin", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)

    def add(name, handler, help_text, host=True, key=False):
        command = commands.add_parser(name, help=help_text)
        if host:
            command.add_argument("host_id")
        if key:
            command.add_argument("key", nargs="+", help="public key, e.g. ssh-ed25519 AAAA... [comment]")
        command.set_defaults(handler=handler)
        return command

    add("list", cmd_list, "show every host's setup state", host=False)
    add("apply", cmd_apply, "render hosts.json into nginx/ttyd/ssh config and install it", host=False)
    add("keygen", cmd_keygen, "create this host's terminal key and print its authorized_keys line") \
        .add_argument("--force", action="store_true", help="replace an existing key (rotation)")
    add("pubkey", cmd_pubkey, "print this host's authorized_keys line again")
    add("token", cmd_token, "create or rotate this host's report token (printed once)")
    add("revoke-token", cmd_revoke_token, "invalidate this host's report token")
    add("hostkey", cmd_hostkey, "pin this host's SSH host public key", key=True)
    add("tunnel-key", cmd_tunnel_key, "authorize a Mac's reverse-tunnel public key", key=True)
    add("check", cmd_check, "test SSH from the terminal account and refuse passwordless sudo")
    add("enable", cmd_enable, "check, then start this host's web terminal") \
        .add_argument("--skip-check", action="store_true")
    add("disable", cmd_disable, "stop this host's web terminal")
    add("join", cmd_join, "print a one-time command that connects this host when pasted on it") \
        .add_argument("--force", action="store_true", help="make a new command (the old one stops working)")
    add("join-all", cmd_join_all, "join commands for every host not connected yet (also on the site)", host=False)
    add("sync", cmd_sync, "apply enrollments: pin keys, authorize tunnels, start terminals", host=False)
    add("legacy-ips", cmd_legacy_ips, "fill placeholder addresses from root's old ~/.ssh/config", host=False)
    args = parser.parse_args(argv)

    if os.geteuid() != 0:
        print("请用 root 运行（sudo remote-term-admin ...）。", file=sys.stderr)
        return 2
    try:
        args.handler(args)
    except AdminError as error:
        print(str(error), file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as error:
        lines = (error.stderr or "").strip().splitlines()
        detail = [line for line in lines if "emerg" in line or "error" in line.lower()] or lines[-1:]
        print(f"命令失败：{' '.join(error.cmd[:2])}", *detail[:3], sep="\n  ", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
