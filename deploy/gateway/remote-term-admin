class AdminError(Exception):
    pass


# ---------- pure helpers (unit-tested) ----------

def parse_public_key(text):
    """Return (type, base64) from 'type base64 [comment]', optionally preceded by options."""
    words = text.strip().split()
    for index, word in enumerate(words):
        if word in KEY_TYPES:
            if index + 1 >= len(words):
                break
            key_type, blob = word, words[index + 1]
            try:
                raw = base64.b64decode(blob, validate=True)
                (length,) = struct.unpack(">I", raw[:4])
                embedded = raw[4:4 + length].decode("ascii")
            except (ValueError, struct.error, UnicodeDecodeError):
                raise AdminError("公钥内容无法解析。") from None
            if embedded != key_type:
                raise AdminError("公钥类型与内容不一致。")
            return key_type, blob
    raise AdminError("没有找到有效的 SSH 公钥（应形如 ssh-ed25519 AAAA...）。")


def terminal_key_line(host_id, key_type, blob):
    # restrict: no port/agent/X11 forwarding; pty: still allow an interactive terminal.
    return f"restrict,pty {key_type} {blob} remote-term-{host_id}"


def tunnel_key_line(host, key_type, blob):
    return (f'restrict,port-forwarding,permitlisten="127.0.0.1:{host["ssh_port"]}" '
            f"{key_type} {blob} remote-term-tunnel-{host['id']}")


def replace_tagged_line(text, tag, line):
    """Drop lines whose last word is tag (or that start with tag for known_hosts) and append line."""
    kept = [existing for existing in text.splitlines()
            if existing.strip() and existing.split()[-1] != tag and existing.split()[0] != tag]
    return "\n".join(kept + [line]) + "\n"


def known_hosts_line(host_id, key_type, blob):
    return f"{host_id} {key_type} {blob}"


def replace_host_lines(text, host_id, lines):
    """Replace every known_hosts line for host_id with lines (a host may offer several key types)."""
    kept = [line for line in text.splitlines() if line.strip() and line.split()[0] != host_id]
    return "\n".join(kept + list(lines)) + "\n"


def apply_address_overrides(hosts, overrides):
    """Fill placeholder ssh.host values from overrides {id: address}; real addresses always win."""
    for host in hosts:
        address = overrides.get(host["id"])
        if host["ssh_host"].startswith("REPLACE") and isinstance(address, str):
            try:
                host["ssh_host"] = str(ipaddress.ip_address(address))
            except ValueError:
                pass
    return hosts


def parse_ssh_g_hostname(output, alias):
    """From `ssh -G alias` output, the configured HostName, or None if the alias is unknown."""
    for line in output.splitlines():
        key, _, value = line.partition(" ")
        if key == "hostname":
            value = value.strip()
            try:
                return str(ipaddress.ip_address(value))
            except ValueError:
                return None if value == alias else value
    return None


def build_bundle(home):
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w:gz") as archive:
        for relative in JOIN_BUNDLE:
            info = archive.gettarinfo(str(Path(home) / relative), arcname=relative)
            info.uid = info.gid = 0
            info.uname = info.gname = "root"
            with open(Path(home) / relative, "rb") as handle:
                archive.addfile(info, handle)
    return base64.b64encode(buffer.getvalue()).decode("ascii")


