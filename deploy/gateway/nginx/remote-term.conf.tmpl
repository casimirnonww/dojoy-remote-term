# remote-term gateway. Generated by deploy/render_config.py from hosts.json:
# edit the template or hosts.json in the repository, never this file on the server.

limit_req_zone $binary_remote_addr zone=remote_term_report:1m rate=30r/m;

map $http_upgrade $remote_term_connection_upgrade {
    default upgrade;
    ""      close;
}

# A WebSocket upgrade must come from our own page (defence in depth next to ttyd -O).
map "$http_upgrade:$http_origin" $remote_term_bad_ws_origin {
    default                                  1;
    "~^:"                                    0;
    "~*^websocket:https://@@DOMAIN_REGEX@@$" 0;
}

# Requests by IP address or for any other name get nothing: no page, no certificate.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN@@;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @@DOMAIN@@;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/@@DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@DOMAIN@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    client_max_body_size 64k;
    root /var/www/remote-term;

@@COMMON_HEADERS@@

    # Every request needs a GitHub login (with that account's two-factor authentication)
    # through oauth2-proxy, except the login flow itself and the per-host report endpoint.
    # oauth2-proxy sends the browser to GitHub and back to the original URI
    # (passed along as X-Auth-Request-Redirect below).
    auth_request /oauth2/auth;
    error_page 401 = /oauth2/start;

    location /oauth2/ {
        auth_request off;
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
    }

    location = /oauth2/auth {
        auth_request off;
        internal;
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
    }

    location = / {
@@COMMON_HEADERS@@
        add_header Content-Security-Policy "@@PAGE_CSP@@" always;
        try_files /index.html =404;
    }

    location = /index.html {
@@COMMON_HEADERS@@
        add_header Content-Security-Policy "@@PAGE_CSP@@" always;
        try_files /index.html =404;
    }

    location ~ ^/(app\.js|app\.css|hosts\.js)$ {
@@COMMON_HEADERS@@
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # The page reads this with fetch(); answer 401 instead of redirecting to GitHub.
    location = /status.json {
        error_page 401 = @remote_term_unauthorized;
        proxy_pass http://127.0.0.1:8790;
        proxy_set_header Host $host;
    }

    location @remote_term_unauthorized {
        auth_request off;
        return 401;
    }

    # Hosts push metrics here with their own bearer token (checked by the receiver).
    location = /api/report {
        auth_request off;
        limit_except POST { deny all; }
        limit_req zone=remote_term_report burst=10 nodelay;
        proxy_pass http://127.0.0.1:8790;
        proxy_set_header Host $host;
    }

@@TTYD_LOCATIONS@@
    location / {
        return 404;
    }
}
